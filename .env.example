# Modelo das variáveis do app. Copie para `.env` (que não vai para o git) e
# preencha com os dados do SEU projeto Supabase, que ficam no painel dele, nas
# configurações do projeto (Project Settings).
#
# Tudo que começa com VITE_ é gravado no JavaScript que o celular baixa:
# qualquer pessoa que abrir o app consegue ler. Aqui só entra o que é público.

# Endereço do projeto Supabase, por exemplo https://seu-projeto.supabase.co
VITE_SUPABASE_URL=

# Chave publicável (pública, papel anon): a que o navegador usa. É a
# publishable, que começa com sb_publishable; em projeto antigo, que só tem as
# chaves legadas, a anon. Nunca a chave secreta ou de serviço (secret ou
# service_role): ela passa por cima da RLS e entregaria o banco inteiro a quem
# abrisse o app.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Nome do app: aparece na tela de entrar, no topo das telas, na aba do
# navegador, no ícone instalado no celular e na folha impressa. Vazio = "Ponto".
VITE_NOME_DO_APP=

# Frase curta embaixo do nome, na tela de entrar, e no pé da tela de bater.
# Vazio = sem frase.
VITE_SLOGAN_DO_APP=
