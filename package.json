{
  "name": "ponto-livre",
  "private": true,
  "version": "0.9.0-beta.1",
  "description": "Registro de ponto por celular: selfie, PIN e localização, com Supabase. Beta.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fumaca": "vitest run src/fumaca-das-rotas.test.ts",
    "e2e": "playwright test",
    "preview": "vite preview",
    "db:iniciar": "supabase start",
    "db:parar": "supabase stop",
    "db:zerar": "supabase db reset",
    "db:testar": "bash scripts/testar-banco.sh",
    "demo:semear": "node demo/semear.mjs",
    "demo:prints": "node demo/prints.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@supabase/supabase-js": "^2.102.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^30.1.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.12"
  }
}
